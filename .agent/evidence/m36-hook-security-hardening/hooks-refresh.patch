+    if verb in {"commit", "merge", "rebase"}:
+        br = branch_of(repo)
+        if br in PROTECTED:
+            deny(
+                "Protected-branch hook: refusing git "
+                f"{verb} on protected branch '{br}' in {repo}."
+            )
+        # merge/rebase onto protected remote-tracking names in args
+        if verb in {"merge", "rebase"}:
