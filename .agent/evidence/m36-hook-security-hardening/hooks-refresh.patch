+import json, os, re, subprocess, sys
+
+PROTECTED = {"main", "master", "develop", "release", "production"}
+
+
+def allow():
+    print(json.dumps({"permission": "allow"}))
+    sys.exit(0)
+
+
+def deny(msg: str):
+    print(json.dumps({
