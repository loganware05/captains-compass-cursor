{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/secret-protection.sh",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/protected-branch.sh",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/branch-name-validation.sh",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/pre-commit-formatting.sh",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/pre-push-tests.sh",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/pr-evidence-validation.sh",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/plan-approval-check.sh",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": true
      }
    ]
  }
}
