#!/usr/bin/env bash
# northstar — topology-free launcher for NorthStar control-plane operations (M24 / M34).
#
# One product surface for Skills Learning Loop + Code Reviewer:
#   northstar skills … | review | intent | outcomes | repair | precision | evaluate | learn | instructions | prompt-eval | policy | status | brain | assess | cycle | learning | provenance | examples
#
# Scripts always live in this control repository. Product/sandbox checkouts do
# not contain ./scripts/run-skill-learning-loop.sh (or siblings).
# Docs index: docs/INDEX.md
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$ROOT/scripts:$PATH"

usage() {
  cat <<'USAGE'
NorthStar launcher — Skills Learning Loop + Code Reviewer (one product)

Usage:
  northstar help
  northstar skills <subcommand> …
  northstar review …
  northstar review ingest-agentic-security …
  northstar intent <subcommand> …
  northstar outcomes <subcommand> …
  northstar repair <subcommand> …
  northstar precision <subcommand> …
  northstar context <subcommand> …
  northstar evaluate <subcommand> …
  northstar learn <subcommand> …
  northstar instructions <subcommand> …
  northstar prompt-eval <subcommand> …
  northstar policy <subcommand> …
  northstar status <subcommand> …
  northstar brain <subcommand> …
  northstar assess <subcommand> …
  northstar provenance <subcommand> …
  northstar examples <subcommand> …

Surfaces (one-line purpose):
  skills      Learning Loop — refresh TI, learn, promote, sync-ledger, route-agents
  review      Code Reviewer — detect→investigate→verify→report (evidence-only default);
              optional ingest-agentic-security (M39, allowlist opt-in)
  intent      Export / normalize intent packs for review (never Captain approval)
  outcomes    Record finding triage → Experience (+ optional proposal-only routing)
  repair      FIND→PROVE→packet from verified findings (never auto-merge)
  precision   Aggregate finding outcomes into precision ledger / dashboard
  context     Filesystem-gated context (M40) — build inode store + walk context routes
  evaluate    Behavior evaluation (M46) — observe-only; requires COMPASS_BEHAVIOR_EVAL_ENABLED=1
  learn       Behavior pattern learning (M47) — proposal-only; requires COMPASS_BEHAVIOR_LEARN_ENABLED=1
  instructions Instruction registry + PICCO composer (M48) — proposal-only; requires COMPASS_INSTRUCTIONS_ENABLED=1
  prompt-eval Prompt evaluation harness (M49) — eval-only; requires COMPASS_PROMPT_EVAL_ENABLED=1
  policy      Policy promotion lifecycle (M50) — requires COMPASS_POLICY_PROMOTE_ENABLED=1
  status      Project Overseer (M51/M52) — read-oriented; requires COMPASS_STATUS_ENABLED=1
  brain       Cognitive Core project-state + context (C1/C2) — requires COMPASS_BRAIN_ENABLED=1
  assess      Cognitive Core difficulty / capability-fit (C3) — requires COMPASS_ASSESS_ENABLED=1
  cycle       Cognitive Core Adaptive Development Loop (C4) — requires COMPASS_CYCLE_ENABLED=1
  learning    Captain Learning Review (C4) — requires COMPASS_CYCLE_ENABLED=1
  provenance Execution provenance ledger (M53) — requires COMPASS_PROVENANCE_ENABLED=1
  examples   Behavior exemplars (M53) — proposal-only; requires COMPASS_PROVENANCE_ENABLED=1

Commands:
  northstar skills refresh [--repo PATH] [refresh-ti-cache.sh options]
  northstar skills learn   --repo PATH --objective TEXT [run-skill-learning-loop.sh options]
  northstar skills promote --repo PATH --candidate PATH [promote-candidate.sh options]
  northstar skills sync-ledger --run PATH [--mode fixtures|link] [options]
  northstar skills route-agents --registry PATH --objective PATH [--out PATH] [--cloud-agents-json PATH]
  northstar review --repo PATH [run-code-review.sh options]
  northstar review ingest-agentic-security --repo PATH --artifact PATH --github-repo OWNER/NAME [options]
  northstar intent export --out PATH [--fixture PATH | --issue ID]
  northstar outcomes record --report PATH --triage PATH [record-finding-outcomes.sh options]
  northstar repair start --report PATH --finding ID [start-repair-loop.sh options]
  northstar precision aggregate (--outcomes PATH | --outcomes-dir PATH) [aggregate-precision-ledger.sh options]
  northstar context build --repo PATH [--check]
  northstar context walk --repo PATH --route domain/module
  northstar evaluate pending [--repo PATH]
  northstar evaluate run <execution-id> [--repo PATH] [--force]
  northstar evaluate review [--repo PATH]
  northstar evaluate retry <evaluation-id> [--repo PATH]
  northstar evaluate export --format csv [--out PATH] [--repo PATH]
  northstar learn scan [--repo PATH]
  northstar learn list [--repo PATH]
  northstar learn show <pattern-id> [--repo PATH]
  northstar learn export --format csv [--out PATH] [--repo PATH]
  northstar instructions list [--repo PATH]
  northstar instructions show <instruction-id> [--repo PATH]
  northstar instructions compose [--agent NAME] [--skill-id ID] [--execution-id ID] [--repo PATH]
  northstar instructions draft-from-candidates [--repo PATH]
  northstar instructions export --format csv [--out PATH] [--repo PATH]
  northstar prompt-eval run [--cases PATH] [--repo PATH]
  northstar prompt-eval compare [--agent NAME] [--skill-id ID] [--repo PATH]
  northstar prompt-eval export --format csv [--out PATH] [--repo PATH]
  northstar policy list [--repo PATH]
  northstar policy show --policy-id ID [--repo PATH]
  northstar policy create --instruction-id ID [--repo PATH]
  northstar policy promote --to STATE (--policy-id ID | --instruction-id ID) [options]
  northstar policy shadow --policy-id ID [--repo PATH]
  northstar policy materialize-proposal --policy-id ID [--repo PATH]
  northstar policy export --format csv [--out PATH] [--repo PATH]
  northstar status snapshot [--repo PATH]
  northstar status explain [--snapshot-id ID] [--repo PATH]
  northstar status compare --since SHA [--repo PATH]
  northstar status reconcile [--snapshot-id ID] [--repo PATH]
  northstar status export --format csv [--out PATH] [--repo PATH]
  northstar brain sync [--repo PATH]
  northstar brain status [--repo PATH]
  northstar brain show --snapshot-id ID [--repo PATH]
  northstar brain context --query TEXT [--mode hybrid|keyword|vector] [--top N] [--repo PATH]
  northstar assess project --objective TEXT [--repo PATH]
  northstar cycle begin --objective TEXT [--plan-id ID] [--repo PATH]
  northstar cycle checkpoint --execution-id ID --checkpoint-key KEY [options] [--repo PATH]
  northstar cycle close --execution-id ID [--outcome success|partial|failed|cancelled] [--repo PATH]
  northstar learning review [--repo PATH]
  northstar provenance capture --execution-id ID [--repo PATH]
  northstar provenance list [--repo PATH]
  northstar provenance show --provenance-id ID [--repo PATH]
  northstar provenance export --format csv [--out PATH] [--repo PATH]
  northstar examples list [--polarity positive|negative] [--repo PATH]
  northstar examples show --exemplar-id ID [--repo PATH]
  northstar examples draft --polarity POLARITY [--evaluation-id ID] [--repo PATH]
  northstar examples export --format csv [--out PATH] [--repo PATH]

Topology:
  CONTROL  = directory containing this launcher (captains-compass-cursor)
  --repo   = product/sandbox repository root (maps to --repo-root on underlying scripts)
  Product installs get docs/Skills via install.sh — control scripts stay in CONTROL

Docs:
  docs/INDEX.md                 Operator index (Learning Loop + Code Reviewer)
  docs/PRODUCT_ONBOARDING.md    Install into a product repo
  docs/integrations/code-reviewer.md
  docs/integrations/linear-skills-learning-loop.md
  docs/integrations/decision-provider.md

Locks:
  Never clones or executes starred repositories.
  Never installs Skills without --captain-approved on promote.
  Linear sync never originates Captain approval.
  Code review (M27+) defaults to evidence-only; M30 draft posting is opt-in.
  Agentic Security ingest (M39) is opt-in + allowlist-gated; hermetic default unchanged.
  Intent packs (M29) never originate Captain approval.
  Finding outcomes (M31) write Experience; RoutingProposal stays proposal-only.
  Repair loop (M32 / B4) is Captain-gated, verified-only, never auto-merges.
  Precision ledger (M33 / B5) never auto-applies reputation / priority.
  Behavior evaluate (M46) is observe-only; requires COMPASS_BEHAVIOR_EVAL_ENABLED=1;
  never mutates routing, Skills, instructions, reputation, or authority.
  Behavior learn (M47) is proposal-only; requires COMPASS_BEHAVIOR_LEARN_ENABLED=1;
  never activates Policies or mutates Skills/routing/instructions/authority.
  Instructions (M48) are proposal-only; requires COMPASS_INSTRUCTIONS_ENABLED=1;
  never activates Policies or writes live .cursor/Skills/routing/authority.
  Prompt-eval (M49) is eval/proposal-only; requires COMPASS_PROMPT_EVAL_ENABLED=1;
  never promotes instructions or mutates .cursor/Skills/routing/authority.
  Policy (M50) requires COMPASS_POLICY_PROMOTE_ENABLED=1; Active compose-include
  requires COMPASS_POLICY_APPLY_ENABLED=1; never auto-writes .cursor/ or grants
  approved_for_execution.
  Status (M51) requires COMPASS_STATUS_ENABLED=1; read-oriented / proposal-only;
  never approves plans, promotes Skills/Policies, or auto-rewrites project memory.
  Brain (C1/C2) requires COMPASS_BRAIN_ENABLED=1; project-state under
  .agent/project-state/; never grants authority or rewrites canonical memory.
  Assess (C3) requires COMPASS_ASSESS_ENABLED=1; advisory difficulty only;
  never bypasses plan approval or mutates authority.
  Cycle/learning (C4) require COMPASS_CYCLE_ENABLED=1; begin also needs
  COMPASS_ASSESS_ENABLED=1; draft proposals only — never auto-promote/merge.
  Prompt-eval (M54) may set COMPASS_PROMPT_EVAL_INCLUDE_EXEMPLARS=1 to append
  curated .agent/examples/ as cases (default off; never auto-promotes).
  Provenance/examples (M53) require COMPASS_PROVENANCE_ENABLED=1; proposal-only;
  never auto-promote Skills/Policies or grant approved_for_execution.
USAGE
}

# Translate agent-facing --repo into underlying --repo-root without dropping other flags.
map_repo_flag() {
  local -a out=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        if [[ $# -lt 2 ]]; then
          echo "error: --repo requires a path" >&2
          exit 2
        fi
        out+=(--repo-root "$2")
        shift 2
        ;;
      --repo=*)
        out+=(--repo-root "${1#--repo=}")
        shift
        ;;
      *)
        out+=("$1")
        shift
        ;;
    esac
  done
  printf '%s\0' "${out[@]}"
}

require_repo_root() {
  local has_repo=0
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--repo-root" ]]; then
      has_repo=1
      break
    fi
  done
  if [[ "$has_repo" -ne 1 ]]; then
    echo "error: --repo <sandbox-or-product-root> is required for this command" >&2
    exit 2
  fi
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

cmd="$1"
shift

case "$cmd" in
  help|-h|--help)
    usage
    exit 0
    ;;
  skills)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      refresh)
        exec "$ROOT/scripts/refresh-ti-cache.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      learn)
        require_repo_root "${mapped[@]+"${mapped[@]}"}"
        exec "$ROOT/scripts/run-skill-learning-loop.sh" "${mapped[@]}"
        ;;
      promote)
        require_repo_root "${mapped[@]+"${mapped[@]}"}"
        exec "$ROOT/scripts/promote-candidate.sh" "${mapped[@]}"
        ;;
      sync-ledger)
        exec "$ROOT/scripts/sync-skill-learning-ledger.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      route-agents)
        exec "$ROOT/scripts/score-agent-routing.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown skills subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  review)
    if [[ "${1:-}" == "ingest-agentic-security" ]]; then
      shift
      # shellcheck disable=SC2207
      mapped=()
      while IFS= read -r -d '' item; do
        mapped+=("$item")
      done < <(map_repo_flag "$@")
      require_repo_root "${mapped[@]+"${mapped[@]}"}"
      exec "$ROOT/scripts/ingest-agentic-security.sh" "${mapped[@]}"
    fi
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    require_repo_root "${mapped[@]+"${mapped[@]}"}"
    exec "$ROOT/scripts/run-code-review.sh" "${mapped[@]}"
    ;;
  intent)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    case "$sub" in
      export)
        exec "$ROOT/scripts/export-intent-from-linear.sh" "$@"
        ;;
      *)
        echo "error: unknown intent subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  outcomes)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    case "$sub" in
      record)
        # shellcheck disable=SC2207
        mapped=()
        while IFS= read -r -d '' item; do
          mapped+=("$item")
        done < <(map_repo_flag "$@")
        exec "$ROOT/scripts/record-finding-outcomes.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown outcomes subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  repair)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    case "$sub" in
      start)
        # shellcheck disable=SC2207
        mapped=()
        while IFS= read -r -d '' item; do
          mapped+=("$item")
        done < <(map_repo_flag "$@")
        exec "$ROOT/scripts/start-repair-loop.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown repair subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  precision)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    case "$sub" in
      aggregate)
        # shellcheck disable=SC2207
        mapped=()
        while IFS= read -r -d '' item; do
          mapped+=("$item")
        done < <(map_repo_flag "$@")
        exec "$ROOT/scripts/aggregate-precision-ledger.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown precision subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  context)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      build)
        require_repo_root "${mapped[@]+"${mapped[@]}"}"
        exec "$ROOT/scripts/build-context-inodes.sh" "${mapped[@]}"
        ;;
      walk)
        require_repo_root "${mapped[@]+"${mapped[@]}"}"
        exec "$ROOT/scripts/walk-context-route.sh" "${mapped[@]}"
        ;;
      *)
        echo "error: unknown context subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  evaluate)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      pending|run|review|retry|export)
        exec "$ROOT/scripts/run-behavior-evaluate.sh" "$sub" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown evaluate subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  learn)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      scan|list|show|export)
        exec "$ROOT/scripts/run-behavior-learn.sh" "$sub" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown learn subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  instructions)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      list|show|compose|draft-from-candidates|export)
        exec "$ROOT/scripts/run-instructions.sh" "$sub" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown instructions subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  prompt-eval)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      run|compare|export)
        exec "$ROOT/scripts/run-prompt-eval.sh" "$sub" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown prompt-eval subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  policy)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      list|show|create|promote|shadow|materialize-proposal|export)
        exec "$ROOT/scripts/run-policy.sh" "$sub" "${mapped[@]+"${mapped[@]}"}"
        ;;
