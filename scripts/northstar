        usage >&2
        exit 2
        ;;
    esac
    ;;
  examples)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      list)
        exec "$ROOT/scripts/run-provenance.sh" examples-list "${mapped[@]+"${mapped[@]}"}"
        ;;
      show)
        exec "$ROOT/scripts/run-provenance.sh" examples-show "${mapped[@]+"${mapped[@]}"}"
        ;;
      draft)
        exec "$ROOT/scripts/run-provenance.sh" examples-draft "${mapped[@]+"${mapped[@]}"}"
        ;;
      export)
        exec "$ROOT/scripts/run-provenance.sh" examples-export "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
