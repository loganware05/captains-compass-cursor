      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      capture|list|show|export)
        exec "$ROOT/scripts/run-provenance.sh" "$sub" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
