        usage >&2
        exit 2
        ;;
    esac
    ;;
  status)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      snapshot|explain|compare|reconcile|export)
        exec "$ROOT/scripts/run-status.sh" "$sub" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown status subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  brain)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      sync|status|show|context)
        exec "$ROOT/scripts/run-brain.sh" "$sub" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown brain subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  assess)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
