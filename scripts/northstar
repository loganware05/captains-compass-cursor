#!/usr/bin/env bash
# northstar — topology-free launcher for NorthStar control-plane operations (M24 / M34).
#
# One product surface for Skills Learning Loop + Code Reviewer:
#   northstar skills … | review | intent | outcomes | repair | precision
#
# Scripts always live in this control repository. Product/sandbox checkouts do
# not contain ./scripts/run-skill-learning-loop.sh (or siblings).
# Docs index: docs/INDEX.md
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$ROOT/scripts:$PATH"

usage() {
  cat <<'USAGE'
NorthStar launcher — Skills Learning Loop + Code Reviewer (one product)

Usage:
  northstar help
  northstar skills <subcommand> …
  northstar review …
  northstar review ingest-agentic-security …
  northstar intent <subcommand> …
  northstar outcomes <subcommand> …
  northstar repair <subcommand> …
  northstar precision <subcommand> …

Surfaces (one-line purpose):
  skills      Learning Loop — refresh TI, learn, promote, sync-ledger, route-agents
  review      Code Reviewer — detect→investigate→verify→report (evidence-only default);
              optional ingest-agentic-security (M39, allowlist opt-in)
  intent      Export / normalize intent packs for review (never Captain approval)
  outcomes    Record finding triage → Experience (+ optional proposal-only routing)
  repair      FIND→PROVE→packet from verified findings (never auto-merge)
  precision   Aggregate finding outcomes into precision ledger / dashboard

Commands:
  northstar skills refresh [--repo PATH] [refresh-ti-cache.sh options]
  northstar skills learn   --repo PATH --objective TEXT [run-skill-learning-loop.sh options]
  northstar skills promote --repo PATH --candidate PATH [promote-candidate.sh options]
  northstar skills sync-ledger --run PATH [--mode fixtures|link] [options]
  northstar skills route-agents --registry PATH --objective PATH [--out PATH] [--cloud-agents-json PATH]
  northstar review --repo PATH [run-code-review.sh options]
  northstar review ingest-agentic-security --repo PATH --artifact PATH --github-repo OWNER/NAME [options]
  northstar intent export --out PATH [--fixture PATH | --issue ID]
  northstar outcomes record --report PATH --triage PATH [record-finding-outcomes.sh options]
  northstar repair start --report PATH --finding ID [start-repair-loop.sh options]
  northstar precision aggregate (--outcomes PATH | --outcomes-dir PATH) [aggregate-precision-ledger.sh options]

Topology:
  CONTROL  = directory containing this launcher (captains-compass-cursor)
  --repo   = product/sandbox repository root (maps to --repo-root on underlying scripts)
  Product installs get docs/Skills via install.sh — control scripts stay in CONTROL

Docs:
  docs/INDEX.md                 Operator index (Learning Loop + Code Reviewer)
  docs/PRODUCT_ONBOARDING.md    Install into a product repo
  docs/integrations/code-reviewer.md
  docs/integrations/linear-skills-learning-loop.md

Locks:
  Never clones or executes starred repositories.
  Never installs Skills without --captain-approved on promote.
  Linear sync never originates Captain approval.
  Code review (M27+) defaults to evidence-only; M30 draft posting is opt-in.
  Agentic Security ingest (M39) is opt-in + allowlist-gated; hermetic default unchanged.
  Intent packs (M29) never originate Captain approval.
  Finding outcomes (M31) write Experience; RoutingProposal stays proposal-only.
  Repair loop (M32 / B4) is Captain-gated, verified-only, never auto-merges.
  Precision ledger (M33 / B5) never auto-applies reputation / priority.
USAGE
}

# Translate agent-facing --repo into underlying --repo-root without dropping other flags.
map_repo_flag() {
  local -a out=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        if [[ $# -lt 2 ]]; then
          echo "error: --repo requires a path" >&2
          exit 2
        fi
        out+=(--repo-root "$2")
        shift 2
        ;;
      --repo=*)
        out+=(--repo-root "${1#--repo=}")
        shift
        ;;
      *)
        out+=("$1")
        shift
        ;;
    esac
  done
  printf '%s\0' "${out[@]}"
}

require_repo_root() {
  local has_repo=0
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--repo-root" ]]; then
      has_repo=1
      break
    fi
  done
  if [[ "$has_repo" -ne 1 ]]; then
    echo "error: --repo <sandbox-or-product-root> is required for this command" >&2
    exit 2
  fi
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

cmd="$1"
shift

case "$cmd" in
  help|-h|--help)
    usage
    exit 0
    ;;
  skills)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    case "$sub" in
      refresh)
        exec "$ROOT/scripts/refresh-ti-cache.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      learn)
        require_repo_root "${mapped[@]+"${mapped[@]}"}"
        exec "$ROOT/scripts/run-skill-learning-loop.sh" "${mapped[@]}"
        ;;
      promote)
        require_repo_root "${mapped[@]+"${mapped[@]}"}"
        exec "$ROOT/scripts/promote-candidate.sh" "${mapped[@]}"
        ;;
      sync-ledger)
        exec "$ROOT/scripts/sync-skill-learning-ledger.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      route-agents)
        exec "$ROOT/scripts/score-agent-routing.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown skills subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  review)
    if [[ "${1:-}" == "ingest-agentic-security" ]]; then
      shift
      # shellcheck disable=SC2207
      mapped=()
      while IFS= read -r -d '' item; do
        mapped+=("$item")
      done < <(map_repo_flag "$@")
      require_repo_root "${mapped[@]+"${mapped[@]}"}"
      exec "$ROOT/scripts/ingest-agentic-security.sh" "${mapped[@]}"
    fi
    # shellcheck disable=SC2207
    mapped=()
    while IFS= read -r -d '' item; do
      mapped+=("$item")
    done < <(map_repo_flag "$@")
    require_repo_root "${mapped[@]+"${mapped[@]}"}"
    exec "$ROOT/scripts/run-code-review.sh" "${mapped[@]}"
    ;;
  intent)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    case "$sub" in
      export)
        exec "$ROOT/scripts/export-intent-from-linear.sh" "$@"
        ;;
      *)
        echo "error: unknown intent subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  outcomes)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    case "$sub" in
      record)
        # shellcheck disable=SC2207
        mapped=()
        while IFS= read -r -d '' item; do
          mapped+=("$item")
        done < <(map_repo_flag "$@")
        exec "$ROOT/scripts/record-finding-outcomes.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown outcomes subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  repair)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    case "$sub" in
      start)
        # shellcheck disable=SC2207
        mapped=()
        while IFS= read -r -d '' item; do
          mapped+=("$item")
        done < <(map_repo_flag "$@")
        exec "$ROOT/scripts/start-repair-loop.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown repair subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  precision)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    sub="$1"
    shift
    case "$sub" in
      aggregate)
        # shellcheck disable=SC2207
        mapped=()
        while IFS= read -r -d '' item; do
          mapped+=("$item")
        done < <(map_repo_flag "$@")
        exec "$ROOT/scripts/aggregate-precision-ledger.sh" "${mapped[@]+"${mapped[@]}"}"
        ;;
      *)
        echo "error: unknown precision subcommand: $sub" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  *)
    echo "error: unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
