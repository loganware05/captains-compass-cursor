# P7: split the evidence flag; when it is False the target is rejected, which
# needs the source state (and Captain approval) only for the gated target.
def Laws.p7a_sandbox_needs_eval_pass(p, t, f, c):
  match p:
    case M.Pre{eval_pass, shadow_ok, shadow_present, proven_ok}:
      match eval_pass:
        case True{}:
          {==}
        case False{}:
          match t:
            case M.Candidate{}:
              {==}
            case M.SandboxEvaluated{}:
              match f:
                case M.Candidate{}:
                  match c:
                    case True{}:
                      {==}
                    case False{}:
                      {==}
                case M.SandboxEvaluated{}:
                  match c:
                    case True{}:
                      {==}
                    case False{}:
                      {==}
                case M.Shadowed{}:
                  match c:
                    case True{}:
                      {==}
                    case False{}:
                      {==}
                case M.Approved{}:
                  match c:
                    case True{}:
                      {==}
                    case False{}:
                      {==}
                case M.Active{}:
                  match c:
                    case True{}:
                      {==}
                    case False{}:
                      {==}
                case M.Proven{}:
                  match c:
                    case True{}:
                      {==}
                    case False{}:
                      {==}
                case M.Retired{}:
                  match c:
                    case True{}:
                      {==}
                    case False{}:
                      {==}
            case M.Shadowed{}:
              {==}
            case M.Approved{}:
              {==}
            case M.Active{}:
              {==}
            case M.Proven{}:
              {==}
            case M.Retired{}:
              {==}

