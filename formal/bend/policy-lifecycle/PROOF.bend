# P2: with c = True the conclusion is immediate; with c = False every
# Captain-required target is rejected whatever the source state.
def Laws.p2_captain_gate(c, t, f, p):
  match c:
    case True{}:
      {==}
    case False{}:
      match t:
        case M.Candidate{}:
          {==}
        case M.SandboxEvaluated{}:
          {==}
        case M.Shadowed{}:
          {==}
        case M.Approved{}:
          match f:
            case M.Candidate{}:
              {==}
            case M.SandboxEvaluated{}:
              {==}
            case M.Shadowed{}:
              {==}
            case M.Approved{}:
              {==}
            case M.Active{}:
              {==}
            case M.Proven{}:
              {==}
            case M.Retired{}:
              {==}
        case M.Active{}:
          match f:
            case M.Candidate{}:
              {==}
            case M.SandboxEvaluated{}:
              {==}
            case M.Shadowed{}:
              {==}
            case M.Approved{}:
              {==}
            case M.Active{}:
              {==}
            case M.Proven{}:
              {==}
            case M.Retired{}:
              {==}
        case M.Proven{}:
          match f:
            case M.Candidate{}:
              {==}
            case M.SandboxEvaluated{}:
              {==}
            case M.Shadowed{}:
              {==}
            case M.Approved{}:
              {==}
            case M.Active{}:
              {==}
            case M.Proven{}:
              {==}
            case M.Retired{}:
              {==}
        case M.Retired{}:
