# Policy lifecycle: the proofs.
#
# Agent-written (generated by gen_proof.py, then rechecked by Bend). Each
# `def Laws.<name>` proves the law of the same name in LAWS.bend.
# Gate: `bend PROOF.bend --verdict` must print ALL PROOFS CHECK.

import Base
import ./Model.bend as M
import ./SPEC.bend as S
import ./LAWS.bend as Laws

# P1/P4/P5: finite case analysis over every (from, to) pair; Bend decides each
# leaf by computation. Captain approval and evidence stay symbolic.
