{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/candidate-capability.schema.json",
  "title": "CandidateCapability",
  "description": "Technology Intelligence discovery signal — not approved for execution.",
  "type": "object",
  "required": [
    "id",
    "version",
    "kind",
    "source",
    "capabilities_provided",
    "approved_for_execution",
    "lifecycle_stage"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "const": "candidate" },
    "source": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": { "type": "string", "enum": ["external-candidate"] },
        "path": { "type": "string" },
        "provenance_url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "capabilities_provided": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "approved_for_execution": { "type": "boolean", "const": false },
    "lifecycle_stage": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "ANALYZED",
        "SECURITY_REVIEWED",
        "SANDBOX_TESTED"
      ]
    },
    "discovery_signal": { "type": "string" },
    "notes": { "type": "string" }
  }
}
