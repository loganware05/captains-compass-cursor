{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.local/schemas/apify-research-packet.schema.json",
  "title": "ApifyResearchPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "provider",
    "mode",
    "query",
    "created_at",
    "candidates",
    "approved_for_execution",
    "authority_mutation",
    "auto_promoted",
    "called_actor"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "packet_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "const": "apify" },
    "mode": { "type": "string", "enum": ["fixture", "live"] },
    "query": { "type": "string" },
    "created_at": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "approved_for_execution": { "type": "boolean", "const": false },
    "authority_mutation": { "type": "boolean", "const": false },
    "auto_promoted": { "type": "boolean", "const": false },
    "called_actor": { "type": "boolean", "const": false },
    "notes": { "type": "string" }
  }
}
