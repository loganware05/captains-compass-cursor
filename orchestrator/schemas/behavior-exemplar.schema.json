{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/behavior-exemplar.schema.json",
  "title": "BehaviorExemplar",
  "description": "Positive/negative behavior exemplar draft (M53). Proposal-only; never auto-promotes.",
  "type": "object",
  "required": [
    "exemplar_id",
    "schema_version",
    "created_at",
    "polarity",
    "summary",
    "approved_for_execution",
    "authority_mutation",
    "auto_promoted"
  ],
  "additionalProperties": false,
  "properties": {
    "exemplar_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "polarity": {
      "type": "string",
      "enum": ["positive", "negative"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "evaluation_id": { "type": "string" },
    "provenance_id": { "type": "string" },
    "execution_id": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" },
    "auto_promoted": { "type": "boolean", "const": false },
    "approved_for_execution": { "type": "boolean", "const": false },
    "authority_mutation": { "type": "boolean", "const": false }
  }
}
