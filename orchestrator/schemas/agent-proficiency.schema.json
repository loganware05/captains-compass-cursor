{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/agent-proficiency.schema.json",
  "title": "AgentProficiency",
  "description": "Captain-approved classification and proficiency tracking for Cursor subagents (Milestone 3).",
  "type": "object",
  "required": [
    "record_id",
    "agent_id",
    "classifications",
    "proficiency_level",
    "captain_approved"
  ],
  "additionalProperties": true,
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "proficiency_level": {
      "type": "string",
      "enum": ["novice", "developing", "proficient", "expert"]
    },
    "skills_trained": {
      "type": "array",
      "items": { "type": "string" }
    },
    "experience_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "captain_approved": { "type": "boolean" },
    "notes": { "type": "string" },
    "updated_at": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
