{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/specialized-model-gpu-job.schema.json",
  "title": "SpecializedModelGpuJob",
  "description": "Level 2 single rented GPU job manifest. Metadata only; never embeds weight binaries.",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "plan_id",
    "level",
    "dataset_id",
    "dataset_path",
    "target_class",
    "vram_gb_range",
    "qlora",
    "holdout_gold_path",
    "cost_estimate_note",
    "approved_for_execution",
    "authority_mutation",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "const": "specialized-model-level-2" },
    "level": { "type": "integer", "const": 2 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_path": { "type": "string", "minLength": 1 },
    "sample_count": { "type": "integer", "minimum": 0 },
    "target_class": { "type": "string", "minLength": 1 },
    "vram_gb_range": { "type": "string", "minLength": 1 },
    "qlora": { "type": "boolean", "const": true },
    "holdout_gold_path": { "type": "string", "minLength": 1 },
    "adapter_root": { "type": ["string", "null"] },
    "cost_estimate_note": { "type": "string" },
    "repository_sha": { "type": "string" },
    "northstar_version": { "type": "string" },
    "notes": { "type": "string" },
    "approved_for_execution": { "type": "boolean", "const": false },
    "authority_mutation": { "type": "boolean", "const": false },
    "generated_at": { "type": "string", "minLength": 1 }
  }
}
