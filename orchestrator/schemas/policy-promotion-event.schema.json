{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/policy-promotion-event.schema.json",
  "title": "PolicyPromotionEvent",
  "description": "Immutable Policy lifecycle transition event (M50).",
  "type": "object",
  "required": [
    "event_id",
    "policy_id",
    "from_state",
    "to_state",
    "created_at",
    "schema_version",
    "captain_approved",
    "approved_for_execution",
    "authority_mutation"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "from_state": { "type": "string", "minLength": 1 },
    "to_state": { "type": "string", "minLength": 1 },
    "prompt_eval_report_id": { "type": "string" },
    "shadow_report_id": { "type": "string" },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "captain_approved": { "type": "boolean" },
    "notes": { "type": "string" },
    "schema_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "approved_for_execution": { "type": "boolean", "const": false },
    "authority_mutation": { "type": "boolean", "const": false }
  }
}
