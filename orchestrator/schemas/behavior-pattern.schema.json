{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/behavior-pattern.schema.json",
  "title": "BehaviorPattern",
  "description": "Recurring behavior pattern detected from M46 ledger (M47). Proposal evidence only.",
  "type": "object",
  "required": [
    "pattern_id",
    "signal",
    "polarity",
    "agent",
    "skill_id",
    "occurrence_count",
    "min_occurrence",
    "evidence_evaluation_ids",
    "schema_version",
    "created_at",
    "approved_for_execution",
    "authority_mutation"
  ],
  "additionalProperties": false,
  "properties": {
    "pattern_id": { "type": "string", "minLength": 1 },
    "signal": { "type": "string", "minLength": 1 },
    "polarity": { "type": "string", "enum": ["positive", "negative"] },
    "agent": { "type": "string" },
    "skill_id": { "type": "string" },
    "occurrence_count": { "type": "integer", "minimum": 1 },
    "min_occurrence": { "type": "integer", "minimum": 1 },
    "mean_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_evaluation_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": { "type": "string" },
    "schema_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "approved_for_execution": { "type": "boolean", "const": false },
    "authority_mutation": { "type": "boolean", "const": false }
  }
}
