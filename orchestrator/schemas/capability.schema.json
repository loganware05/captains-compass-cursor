{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/capability.schema.json",
  "title": "Capability",
  "description": "Structured metadata for a Compass Skill, agent profile, or staged candidate.",
  "type": "object",
  "required": ["id", "version", "kind", "source", "capabilities_provided"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["skill", "agent-profile", "candidate"]
    },
    "source": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["compass-skill", "compass-agent", "external-candidate"]
        },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "authored_by": { "type": "string" },
        "inferred": { "type": "boolean" },
        "maturity": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "ANALYZED",
        "SECURITY_REVIEWED",
        "SANDBOX_TESTED",
        "APPROVED",
        "AVAILABLE_SKILL",
        "PROVEN_SKILL"
      ]
    },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities_provided": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "compatible_stacks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "security_sensitivity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "agent_affinity": {
      "type": "array",
      "items": { "type": "string" }
    },
    "maturity": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
