{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/session-memory-search-response.schema.json",
  "title": "SessionMemorySearchResponse",
  "description": "Compact session-memory search index. Full bodies require memory show by id.",
  "type": "object",
  "required": [
    "schema_version",
    "query",
    "results",
    "approved_for_execution",
    "authority_mutation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "query": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observation_id", "title", "summary", "query_score"],
        "additionalProperties": false,
        "properties": {
          "observation_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "created_at": { "type": "string" },
          "query_score": { "type": "number" }
        }
      }
    },
    "notes": { "type": "string" },
    "approved_for_execution": { "type": "boolean", "const": false },
    "authority_mutation": { "type": "boolean", "const": false }
  }
}
