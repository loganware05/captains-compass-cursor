{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/scope-ledger.schema.json",
  "title": "ScopeLedger",
  "description": "Project Overseer scope ledger (M52). Non-canonical; never grants authority.",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "snapshot_id",
    "entries",
    "canonical_memory_untouched",
    "approved_for_execution",
    "authority_mutation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string" },
    "repository_sha": { "type": "string" },
    "northstar_version": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry_id", "claim_kind", "summary"],
        "additionalProperties": false,
        "properties": {
          "entry_id": { "type": "string", "minLength": 1 },
          "claim_kind": {
            "type": "string",
            "enum": ["observed", "documented", "external", "proposed"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "severity": { "type": "string" },
          "kind": { "type": "string" }
        }
      }
    },
    "canonical_memory_untouched": { "type": "boolean", "const": true },
    "approved_for_execution": { "type": "boolean", "const": false },
    "authority_mutation": { "type": "boolean", "const": false }
  }
}
