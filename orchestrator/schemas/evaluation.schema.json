{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/evaluation.schema.json",
  "title": "Evaluation",
  "description": "Bounded Captain Compass Evaluator experiment comparing alternatives (Milestone 3).",
  "type": "object",
  "required": [
    "evaluation_id",
    "plan_id",
    "objective",
    "alternatives",
    "outcome",
    "recommendation"
  ],
  "additionalProperties": true,
  "properties": {
    "evaluation_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string" },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" },
          "score": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "method": { "type": "string" },
    "outcome": {
      "type": "string",
      "enum": ["pending", "complete", "inconclusive", "failed", "cancelled"]
    },
    "recommendation": { "type": "string", "minLength": 1 },
    "winner_alternative_id": { "type": "string" },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": { "type": "string", "minLength": 1 },
    "captain_approval_required": { "type": "boolean", "const": true }
  }
}
