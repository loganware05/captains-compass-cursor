{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.dev/schemas/finding-outcome.schema.json",
  "title": "NorthStarFindingOutcome",
  "description": "Human triage outcome for a Code Reviewer finding (M31). Never carries Captain approval authority.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "finding_id",
    "decision",
    "label",
    "skill",
    "captain_approval"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "northstar.finding_outcome.v1"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "finding_id": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["accepted", "rejected", "deferred"]
    },
    "label": {
      "type": "string",
      "enum": ["tp", "fp", "unknown"]
    },
    "skill": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "title": { "type": "string" },
    "severity": { "type": "string" },
    "report_path": { "type": "string" },
    "created_at": { "type": "string" },
    "captain_approval": {
      "type": "boolean",
      "const": false,
      "description": "Always false. Outcomes never originate Captain approval."
    }
  }
}
