{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northstar.repair_run.v1",
  "title": "NorthStar repair run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "stage",
    "repository",
    "finding",
    "dispatch_packet",
    "submit",
    "locks"
  ],
  "properties": {
    "schema_version": { "const": "northstar.repair_run.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "stage": { "type": "string" },
    "repository": { "type": "string" },
    "finding": { "type": "object" },
    "report_path": { "type": "string" },
    "dispatch_packet": { "type": "object" },
    "submit": { "type": "object" },
    "locks": { "type": "object" }
  },
  "additionalProperties": true
}
