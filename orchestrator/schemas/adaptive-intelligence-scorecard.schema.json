{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/adaptive-intelligence-scorecard.schema.json",
  "title": "AdaptiveIntelligenceScorecard",
  "description": "N3 Adaptive Intelligence Validation scorecard. Proposal-only; never auto-applies routing/Skills/policies or Level 3 spend.",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "created_at",
    "phase",
    "northstar_version",
    "metrics",
    "level3_recommendation",
    "level3_rationale",
    "approved_for_execution",
    "authority_mutation",
    "auto_applied"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "report_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "enum": ["baseline", "with_evidence", "compare"]
    },
    "repository_sha": { "type": "string" },
    "northstar_version": { "type": "string" },
    "metrics": {
      "type": "object",
      "required": [
        "project_state_accuracy",
        "difficulty_calibration",
        "routing_effectiveness",
        "skill_reuse",
        "review_precision",
        "context_efficiency",
        "training_effectiveness"
      ],
      "additionalProperties": false,
      "properties": {
        "project_state_accuracy": { "$ref": "#/$defs/metric" },
        "difficulty_calibration": { "$ref": "#/$defs/metric" },
        "routing_effectiveness": { "$ref": "#/$defs/metric" },
        "skill_reuse": { "$ref": "#/$defs/metric" },
        "review_precision": { "$ref": "#/$defs/metric" },
        "context_efficiency": { "$ref": "#/$defs/metric" },
        "training_effectiveness": { "$ref": "#/$defs/metric" }
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": { "type": ["number", "null"] }
    },
    "baseline_report_id": { "type": ["string", "null"] },
    "evidence_report_id": { "type": ["string", "null"] },
    "level3_recommendation": {
      "type": "string",
      "enum": ["defer", "consider"]
    },
    "level3_rationale": { "type": "string", "minLength": 1 },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_path": { "type": ["string", "null"] },
    "notes": { "type": "string" },
    "approved_for_execution": { "type": "boolean", "const": false },
    "authority_mutation": { "type": "boolean", "const": false },
    "auto_applied": { "type": "boolean", "const": false }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["name", "value", "unit", "status", "summary"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pass", "warn", "fail", "skipped"]
        },
        "summary": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
