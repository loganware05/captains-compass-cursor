{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captains-compass.dev/schemas/procedure-promotion.schema.json",
  "title": "ProcedurePromotion",
  "description": "Proposal to promote a knowledge procedure to a reusable playbook. Staging only; Captain PR required (Milestone 5).",
  "type": "object",
  "required": [
    "proposal_id",
    "kind",
    "knowledge_item_ids",
    "procedure_title",
    "gates_passed",
    "staging_paths",
    "landing_mode",
    "captain_approval_required"
  ],
  "additionalProperties": true,
  "properties": {
    "proposal_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "const": "procedure-promotion" },
    "knowledge_item_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "procedure_title": { "type": "string", "minLength": 1 },
    "gates_passed": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "staging_paths": {
      "type": "object",
      "properties": {
        "playbook_markdown": { "type": "string" }
      },
      "additionalProperties": true
    },
    "landing_mode": {
      "type": "string",
      "const": "staging_and_pr_only"
    },
    "captain_approval_required": { "type": "boolean", "const": true },
    "notes": { "type": "string" },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
